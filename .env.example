# =======================================================
# SWIFTPAY ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================
# Copy this file to '.env' before running the application locally or deploying to Render.

# Server Port (Default is 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Base URL of your deployed application (e.g. https://swiftpay.onrender.com or http://localhost:3000)
APP_URL="http://localhost:3000"

# -------------------------------------------------------
# KORAPAY PAYMENT GATEWAY CONFIGURATION
# -------------------------------------------------------
# Obtain from https://dashboard.korapay.com/settings/api-webhook
KORAPAY_SECRET_KEY="sk_live_your_korapay_secret_key"
KORAPAY_PUBLIC_KEY="pk_live_your_korapay_public_key"
KORAPAY_WEBHOOK_SECRET="your_korapay_webhook_secret"
KORAPAY_SECRET_HASH="your_korapay_webhook_hash"

# -------------------------------------------------------
# GEMINI AI API CONFIGURATION
# -------------------------------------------------------
# Required for SwiftPay Assistant AI Customer Support Chatbot.
# Obtain a key at https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# -------------------------------------------------------
# DATABASE CONFIGURATION (OPTIONAL)
# -------------------------------------------------------
# Live PostgreSQL Connection URL (e.g., active Render PostgreSQL, Supabase, or Neon).
# Leave empty or omit if you do not have an active PostgreSQL database — SwiftPay automatically
# uses its built-in persistent JSON database store (swiftpay_db.json).
# Do NOT leave a deleted/expired Render database hostname configured in DATABASE_URL.
DATABASE_URL=""
